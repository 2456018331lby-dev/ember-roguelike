{
  "name": "ember-roguelike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/game_core.test.mjs",
    "test:boss-checkpoints": "node tests/boss_checkpoint_sim.mjs",
    "test:web-smoke": "node scripts/web-smoke.mjs",
    "test:visual-smoke": "node scripts/visual-smoke.mjs",
    "test:visual-regression": "node scripts/visual-regression.mjs",
    "assets:generate": "node scripts/generate-art-assets.mjs",
    "serve": "node scripts/serve-web.mjs",
    "sync:web": "node scripts/sync-web.mjs",
    "sync:android": "node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "build:android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "verify:android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-debug.ps1 -AutoStartSingleAvd -ShutdownStartedEmulator",
    "verify:android:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-android-debug.ps1 -AutoStartSingleAvd -SmokeTapFlow -ShutdownStartedEmulator"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1"
  }
}
